#!/usr/bin/env bash
# Report how many Claude Code sessions are actually doing work, as busy/total.
#
# Source of truth: ~/.claude/sessions/<pid>.json, which every interactive
# session maintains with a "status" field. Values: busy | shell | waiting | idle
#   busy    -> model/tool loop is running (this is "doing work")
#   shell   -> user dropped into a shell from the session
#   waiting -> blocked on the user (permission prompt / question)
#   idle    -> sitting at the prompt
#
# Stale files are filtered out two ways: the PID must still exist, and
# /proc/<pid>/stat field 22 (starttime) must match the recorded procStart,
# which rules out PID reuse.
#
# Usage: cc-busy [-v] [-s status1,status2]
#   -v  list every live session, one per line, instead of the busy/total count
#   -s  which statuses count as busy (default: busy)

set -euo pipefail

verbose=0
want="busy"
while getopts "vs:" opt; do
  case $opt in
    v) verbose=1 ;;
    s) want=$OPTARG ;;
    *) exit 2 ;;
  esac
done

dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/sessions"
[[ -d $dir ]] || { [[ $verbose == 1 ]] || echo "0/0"; exit 0; }

python3 - "$dir" "$want" "$verbose" <<'PY'
import json, os, sys, time

dir_, want, verbose = sys.argv[1], set(sys.argv[2].split(",")), sys.argv[3] == "1"
live = []

for name in os.listdir(dir_):
    if not name.endswith(".json"):
        continue
    try:
        s = json.load(open(os.path.join(dir_, name)))
    except Exception:
        continue

    pid = s.get("pid")
    if not isinstance(pid, int):
        continue

    # PID still alive?
    try:
        os.kill(pid, 0)
    except OSError:
        continue

    # Same process, not a recycled PID? (Linux; skip the check elsewhere.)
    try:
        with open(f"/proc/{pid}/stat") as f:
            starttime = f.read().rsplit(")", 1)[1].split()[19]
        if s.get("procStart") and str(s["procStart"]) != starttime:
            continue
    except OSError:
        pass

    # Headless runs (`claude -p`, entrypoint "sdk-cli") never write a status.
    # They exist only for the duration of one turn, so alive == working.
    if s.get("status") is None and s.get("entrypoint") == "sdk-cli":
        s["status"] = "busy"

    live.append(s)

busy = [s for s in live if s.get("status") in want]

if not verbose:
    print(f"{len(busy)}/{len(live)}")
else:
    for s in sorted(live, key=lambda r: r.get("statusUpdatedAt", 0)):
        ts = s.get("statusUpdatedAt")
        age = f"{int(time.time() - ts / 1000)}s" if ts else "-"
        print(
            f"{s['pid']:>8}  {s.get('status') or '?':<7} {age:>6}  "
            f"{s.get('tmux','-'):<16} {s.get('name') or os.path.basename(s.get('cwd',''))}"
        )
PY
